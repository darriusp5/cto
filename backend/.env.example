# Режим: development | production
NODE_ENV=development

# База данных.
# Docker (prod): используется PostgreSQL 15 из docker-compose.yml.
#   DATABASE_URL=postgresql://ekl:${DB_PASSWORD}@postgres:5432/ekl
# Локальная разработка без Docker (SQLite): переключите provider в
# prisma/schema.prisma на "sqlite" и задайте:
#   DATABASE_URL=sqlite:./dev.db
DATABASE_URL=postgresql://ekl:ekl_password@localhost:5432/ekl

# Порт HTTP-сервера (в docker-compose — 3000)
PORT=3000

# Секрет подписи JWT (обязательно смените в production)
JWT_SECRET=dev_secret_key

# Ключ SMS-шлюза (заполняется на этапе 2)
SMS_API_KEY=

# Разрешить dev-вход без реальной SMS (код в консоль)
ALLOW_DEV_LOGIN=true

# Папка загрузок (multer)
UPLOAD_DIR=uploads
