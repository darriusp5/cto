# ekl.by — переменные окружения для Docker-развёртывания.
# Скопируйте в .env и задайте реальные значения.

# Пароль пользователя БД (postgres-контейнер)
DB_PASSWORD=ekl_password

# Секрет подписи JWT (обязательно смените!)
JWT_SECRET=your_secure_jwt_secret

# Ключ SMS-шлюза (этап 2)
SMS_API_KEY=your_real_sms_api_key

# Разрешить dev-вход без реальной SMS (false в production)
ALLOW_DEV_LOGIN=true
